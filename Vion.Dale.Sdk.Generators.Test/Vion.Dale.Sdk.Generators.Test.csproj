<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1"/>
        <PackageReference Include="MSTest" Version="4.0.2"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.2"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vion.Dale.Sdk.Generators\Vion.Dale.Sdk.Generators.csproj"/>
    </ItemGroup>

    <!-- The analyzer-wiring probe is source for OTHER projects' builds, never for this one: it names SDK
         types this project does not reference. AnalyzerWiringShould links it into Vion.Dale.Sdk.DigitalIo /
         .AnalogIo under -p:DaleAnalyzerWiringProbe=true and requires DALE046 to fail those builds. -->
    <ItemGroup>
        <Compile Remove="AnalyzerWiring\**"/>
        <None Include="AnalyzerWiring\**"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Vendored predicate conformance vector (source: vion-contracts). Copied to output so the
             conformance test reads it beside the test assembly. -->
        <None Include="Predicates\predicate-conformance.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting"/>
    </ItemGroup>

</Project>
