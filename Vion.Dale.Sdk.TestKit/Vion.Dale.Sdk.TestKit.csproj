<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet package metadata -->
        <PackageId>Vion.Dale.Sdk.TestKit</PackageId>
        <Description>Dale SDK TestKit for unit testing logic blocks</Description>
        <IsPackable>true</IsPackable>

        <!--documentation related-->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- 1591: missing XML doc comments. -->
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0"/>
        <!-- FakeTimeProvider drives virtual time inside LogicBlockTestContext (clock reads + scheduled actions). -->
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0"/>
        <PackageReference Include="Moq" Version="4.20.72"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vion.Dale.Sdk\Vion.Dale.Sdk.csproj"/>
    </ItemGroup>

    <!-- The Dale analyzers, run over this kit's own declarations. Compile-time only. Without it the
         [assembly: PublicApiNamespace] above has no reader, so DALE014 never asks a kit for a surface
         mark and the API manifest diff is the only gate on a quarter of it. -->
    <ItemGroup>
        <ProjectReference Include="..\Vion.Dale.Sdk.Generators\Vion.Dale.Sdk.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
    </ItemGroup>

    <!-- The analyzer-wiring probe: a public type carrying neither surface mark, which DALE014 must
         reject. NOT a source file of this project - it lives with the test that owns it and is linked
         in only under `dotnet build -p:DaleTestKitAnalyzerWiringProbe=true` (its own property, so it does not
         also switch on the I/O projects' DALE046 probe further down the reference graph), where the build MUST fail. That is
         the standing proof the analyzer reference above is live and not merely present; nothing about it
         reaches an ordinary build, the compiled assembly or the package. AnalyzerWiringShould runs it. -->
    <ItemGroup Condition="'$(DaleTestKitAnalyzerWiringProbe)' == 'true'">
        <Compile Include="..\Vion.Dale.Sdk.Generators.Test\AnalyzerWiring\TestKitPublicApiWiringProbe.cs"
                 Link="AnalyzerWiring\TestKitPublicApiWiringProbe.cs"/>
    </ItemGroup>
</Project>