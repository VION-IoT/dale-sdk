<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- NuGet package metadata -->
        <PackageId>Vion.Examples.Http</PackageId>
        <Version>0.14.2</Version>
        <Authors>Vion</Authors>
        <Company>Vion</Company>
        <Description>Interactive HTTP debug client: send one request with any method, URL, headers and body and see the status, latency, response headers and a body preview, plus a simulated HTTP server with editable routes so it runs without a device.</Description>
        <IsPackable>false</IsPackable>

        <!--debug information from the source generator-->
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <!-- SDK refs: the published packages by default. `dotnet build -p:DaleLocalSource=true` swaps them for
         local project refs (incl. the source generator + Metalama, which don't flow through a project ref) so
         you can test working-tree SDK changes against this example without editing the csproj. -->
    <ItemGroup Condition="'$(DaleLocalSource)' != 'true'">
        <PackageReference Include="Vion.Dale.Sdk" Version="0.14.2"/>
        <PackageReference Include="Vion.Dale.Sdk.Http" Version="0.14.2"/>
    </ItemGroup>
    <ItemGroup Condition="'$(DaleLocalSource)' == 'true'">
        <ProjectReference Include="..\..\..\Vion.Dale.Sdk\Vion.Dale.Sdk.csproj"/>
        <ProjectReference Include="..\..\..\Vion.Dale.Sdk.Generators\Vion.Dale.Sdk.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
        <PackageReference Include="Metalama.Patterns.Observability" Version="2026.1.18"/>
        <ProjectReference Include="..\..\..\Vion.Dale.Sdk.Http\Vion.Dale.Sdk.Http.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!--shim to be able to use readonly record structs in netstandard2.1-->
        <PackageReference Include="IsExternalInit" Version="1.0.3">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!--shim to be able to use required members in netstandard2.1-->
        <PackageReference Include="RequiredMemberAttribute" Version="1.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
