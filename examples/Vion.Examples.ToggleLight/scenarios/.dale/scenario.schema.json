{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vion.swiss/dale/scenario.schema.json",
  "title": "Dale DevHost scenario file (vocabulary v1)",
  "description": "A git-committed description of a manual-test scenario: setup, ordered stimuli, watch list, human judgments. The generic structural schema shipped with Vion.Dale.DevHost; 'dale scenario schema' (R4) emits a per-project variant enriched with the topology's actual block names and property identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "topology"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1,
      "description": "Vocabulary version. Runners reject unknown versions loudly; evolution is by version bump."
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ss][Cc][Hh][Ee][Mm][Aa]$"
          },
          {
            "pattern": "\\.\\."
          }
        ]
      },
      "description": "URL-safe slug, no '..'; must match the file name (<id>.scenario.json). 'schema' is reserved (GET /api/scenarios/schema). Deep-link route: #/scenario/{id}."
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "topology": {
      "type": "string",
      "description": "The topology id this scenario expects (a C# preset's declared name or a topology file id). Mismatch blocks the run."
    },
    "specs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Free-form trace ids for the scenario as a whole (consumer policy, e.g. AC-EM-23)."
    },
    "setup": {
      "type": "array",
      "description": "Staging entries, applied in file order before steps; keep them order-independent and idempotent. No waits.",
      "items": {
        "$ref": "#/$defs/setupEntry"
      }
    },
    "steps": {
      "type": "array",
      "description": "Ordered stimuli and outcome waits; order is semantically significant.",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "watch": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namePath"
      },
      "description": "Name paths the Player pins as live tiles; validated up front on every run (a watch-only scenario smokes renames)."
    },
    "judge": {
      "type": "array",
      "description": "Human-judgment checklist items. v1 has no auto-asserting checks.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "The judgment a human renders; whitespace only is not one."
          },
          "spec": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "namePath": {
      "type": "string",
      "description": "Block.Property (when unambiguous within the block) or Block.Service.Property (the qualified form for multi-service blocks).",
      "enum": [
        "Light.ConfirmedOn",
        "Light.Light.ConfirmedOn",
        "Light.Light.On",
        "Light.Light.TimesSwitchedOn",
        "Light.Light.ToggleMode",
        "Light.Light.TotalTimeOn",
        "Light.On",
        "Light.TimesSwitchedOn",
        "Light.ToggleMode",
        "Light.TotalTimeOn",
        "Relay.CommandCount",
        "Relay.IdealRelay.CommandCount",
        "Relay.IdealRelay.LastCommand",
        "Relay.LastCommand",
        "Toggle.Mode",
        "Toggle.Toggle.Mode"
      ]
    },
    "value": {
      "description": "A scalar, an enum member name (case-sensitive string), a complete struct/array literal, or null (nullable properties)."
    },
    "comparand": {
      "not": {
        "type": [
          "object",
          "array"
        ]
      },
      "description": "A scalar, enum member name, or null — structs/arrays are not comparable in v1."
    },
    "pathComparand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/namePath"
        }
      },
      "description": "A relational comparand resolved to another path's current value at assert time (expect only)."
    },
    "relationalComparand": {
      "oneOf": [
        {
          "$ref": "#/$defs/comparand"
        },
        {
          "$ref": "#/$defs/pathComparand"
        }
      ],
      "description": "A literal scalar/enum/null, or a { path } object resolved at assert time (expect only)."
    },
    "numericComparand": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/pathComparand"
        }
      ],
      "description": "A literal number, or a { path } object resolved to a numeric leaf at assert time (expect only)."
    },
    "oneOfComparand": {
      "type": "array",
      "minItems": 1,
      "items": {
        "not": {
          "type": [
            "object",
            "array"
          ]
        }
      },
      "description": "A non-empty array of scalars/enum names; value ∈ this set satisfies the comparator."
    },
    "stepCommon": {
      "label": {
        "type": "string",
        "description": "Shown in the Player and in reports."
      },
      "spec": {
        "type": "string",
        "description": "Free-form trace id for this step."
      }
    },
    "setStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set",
        "value"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/stepCommon/label"
        },
        "spec": {
          "$ref": "#/$defs/stepCommon/spec"
        },
        "set": {
          "$ref": "#/$defs/namePath"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "waitUntilStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waitUntil"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/stepCommon/label"
        },
        "spec": {
          "$ref": "#/$defs/stepCommon/spec"
        },
        "waitUntil": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "property"
          ],
          "properties": {
            "property": {
              "$ref": "#/$defs/namePath"
            },
            "above": {
              "type": "number"
            },
            "below": {
              "type": "number"
            },
            "equals": {
              "$ref": "#/$defs/comparand"
            },
            "notEquals": {
              "$ref": "#/$defs/comparand"
            },
            "oneOf": {
              "$ref": "#/$defs/oneOfComparand"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0,
              "description": "Only with a numeric equals."
            }
          },
          "oneOf": [
            {
              "required": [
                "above"
              ]
            },
            {
              "required": [
                "below"
              ]
            },
            {
              "required": [
                "equals"
              ]
            },
            {
              "required": [
                "notEquals"
              ]
            },
            {
              "required": [
                "oneOf"
              ]
            }
          ],
          "dependentSchemas": {
            "tolerance": {
              "required": [
                "equals"
              ],
              "properties": {
                "equals": {
                  "type": "number"
                }
              }
            }
          }
        },
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4294967,
          "default": 20
        }
      }
    },
    "expectStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expect"
      ],
      "description": "A deterministic, point-in-time auto-assertion on the current value (CI-failing tier). Read once; fail the run if the comparator does not hold.",
      "properties": {
        "label": {
          "$ref": "#/$defs/stepCommon/label"
        },
        "spec": {
          "$ref": "#/$defs/stepCommon/spec"
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "property"
          ],
          "properties": {
            "property": {
              "$ref": "#/$defs/namePath"
            },
            "above": {
              "$ref": "#/$defs/numericComparand"
            },
            "below": {
              "$ref": "#/$defs/numericComparand"
            },
            "equals": {
              "$ref": "#/$defs/relationalComparand"
            },
            "notEquals": {
              "$ref": "#/$defs/relationalComparand"
            },
            "oneOf": {
              "$ref": "#/$defs/oneOfComparand"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0,
              "description": "Only with a numeric equals."
            }
          },
          "oneOf": [
            {
              "required": [
                "above"
              ]
            },
            {
              "required": [
                "below"
              ]
            },
            {
              "required": [
                "equals"
              ]
            },
            {
              "required": [
                "notEquals"
              ]
            },
            {
              "required": [
                "oneOf"
              ]
            }
          ],
          "dependentSchemas": {
            "tolerance": {
              "required": [
                "equals"
              ],
              "properties": {
                "equals": {
                  "$ref": "#/$defs/numericComparand"
                }
              }
            }
          }
        }
      }
    },
    "advanceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advance"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/stepCommon/label"
        },
        "spec": {
          "$ref": "#/$defs/stepCommon/spec"
        },
        "advance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seconds"
          ],
          "properties": {
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4294967,
              "description": "Seconds of time to let elapse — virtual on a stepped host, real wall-clock on a real-clock host. Capped at what a run can spend."
            }
          }
        }
      },
      "description": "Let time elapse by a fixed budget. Host-adaptive: a stepped host advances the virtual clock instantly and deterministically (firing every scheduled timer within the budget); a real-clock host waits the same span of real wall-clock time, during which real timers fire."
    },
    "settleStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settle"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/stepCommon/label"
        },
        "spec": {
          "$ref": "#/$defs/stepCommon/spec"
        },
        "settle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "until": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/namePath"
              },
              "description": "Explicit target paths that must stabilize for convergence; omit to settle over the whole watch list. A large watch set is for observability — scope settle to the specific values meant to settle so a volatile tile (free-running counter / clock-derived value / noisy sensor) does not burn the budget."
            },
            "maxSeconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4294967,
              "default": 60,
              "description": "Maximum seconds (virtual on a stepped host, real on a real-clock host) to spend waiting for convergence. Capped at what a run can spend."
            }
          }
        }
      },
      "description": "Let the targeted signals run until they stop changing. Host-adaptive: a stepped host advances hop-by-hop; a real-clock host polls until the targets hold steady across a short quiet window. The targeted set is settle.until when given, else the whole watch list. FAILS the step if the maxSeconds budget elapses while a target is still changing."
    },
    "serviceProviderRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicBlock",
        "contract"
      ],
      "description": "A service-provider value-contract reference: the consuming logic block name plus the contract identifier.",
      "properties": {
        "logicBlock": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        }
      }
    },
    "serviceProviderSetStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceProviderSet",
        "value"
      ],
      "description": "Drives the wire value a service provider delivers on a [ServiceProviderContractType] contract — a scalar for digital/analog, a JSON object for a struct contract (PPC). Available on any contract whose handler declares a [ScenarioWire] inbound: an input, a bidirectional contract, or the confirmation an output's provider sends back. The generic replacement for digitalInput / analogInput.",
      "properties": {
        "label": {
          "$ref": "#/$defs/stepCommon/label"
        },
        "spec": {
          "$ref": "#/$defs/stepCommon/spec"
        },
        "serviceProviderSet": {
          "$ref": "#/$defs/serviceProviderRef"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "serviceProviderExpectStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceProviderExpect"
      ],
      "description": "A deterministic, point-in-time auto-assertion on the value a block last wrote on a [ServiceProviderContractType] value contract (CI-failing tier) — an output, or a bidirectional contract whose handler declares a [ScenarioWire] Outbound. The generic replacement for digitalOutput / analogOutput.",
      "properties": {
        "label": {
          "$ref": "#/$defs/stepCommon/label"
        },
        "spec": {
          "$ref": "#/$defs/stepCommon/spec"
        },
        "serviceProviderExpect": {
          "$ref": "#/$defs/serviceProviderOutputAssert"
        }
      }
    },
    "serviceProviderOutputAssert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicBlock",
        "contract"
      ],
      "description": "A service-provider value-output contract reference (logicBlock + contract), an optional field selecting one scalar of a multi-field command, plus exactly one comparator, checked against the value the block last wrote on that contract. Comparands are literals only (no relational { path } form).",
      "properties": {
        "logicBlock": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        },
        "field": {
          "type": "string",
          "description": "Which scalar of the command to compare, for a contract whose outbound carries more than one field — the wire keys, dotted through a nested struct (limits.activePowerW), matched case-insensitively. Required for such a contract (a whole command is not comparable) and rejected for one that writes a single value."
        },
        "above": {
          "type": "number"
        },
        "below": {
          "type": "number"
        },
        "equals": {
          "$ref": "#/$defs/comparand"
        },
        "notEquals": {
          "$ref": "#/$defs/comparand"
        },
        "oneOf": {
          "$ref": "#/$defs/oneOfComparand"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "description": "Only with a numeric equals."
        }
      },
      "oneOf": [
        {
          "required": [
            "above"
          ]
        },
        {
          "required": [
            "below"
          ]
        },
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "notEquals"
          ]
        },
        {
          "required": [
            "oneOf"
          ]
        }
      ],
      "dependentSchemas": {
        "tolerance": {
          "required": [
            "equals"
          ],
          "properties": {
            "equals": {
              "type": "number"
            }
          }
        }
      }
    },
    "setupEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/setStep"
        },
        {
          "$ref": "#/$defs/serviceProviderSetStep"
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/setStep"
        },
        {
          "$ref": "#/$defs/serviceProviderSetStep"
        },
        {
          "$ref": "#/$defs/serviceProviderExpectStep"
        },
        {
          "$ref": "#/$defs/waitUntilStep"
        },
        {
          "$ref": "#/$defs/expectStep"
        },
        {
          "$ref": "#/$defs/advanceStep"
        },
        {
          "$ref": "#/$defs/settleStep"
        }
      ]
    }
  }
}