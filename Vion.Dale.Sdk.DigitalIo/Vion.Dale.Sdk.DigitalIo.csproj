<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- NuGet package metadata -->
        <PackageId>Vion.Dale.Sdk.DigitalIo</PackageId>
        <Description>Digital input and output functionality for logic blocks</Description>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--shim to be able to use readonly record structs in netstandard2.1-->
        <PackageReference Include="IsExternalInit" Version="1.0.3">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!--shim to be able to use required members in netstandard2.1-->
        <PackageReference Include="RequiredMemberAttribute" Version="1.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- The analyzer-wiring probe: a deliberately invalid [ScenarioWire] declaration that DALE046 must
         reject. It is NOT a source file of this project - it lives with the test that owns it and is linked
         in only under `dotnet build -p:DaleAnalyzerWiringProbe=true`, where the build MUST fail. That is the
         standing proof the analyzer reference below is live and not merely present; nothing about it reaches
         an ordinary build, the compiled assembly or the package. AnalyzerWiringShould runs it. -->
    <ItemGroup Condition="'$(DaleAnalyzerWiringProbe)' == 'true'">
        <Compile Include="..\Vion.Dale.Sdk.Generators.Test\AnalyzerWiring\ScenarioWireWiringProbe.cs"
                 Link="AnalyzerWiring\ScenarioWireWiringProbe.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Vion.Dale.Sdk\Vion.Dale.Sdk.csproj"/>
        <!-- The Dale analyzers, run over this project's own declarations. Compile-time only: without it the
             reference [ScenarioWire] implementations were the one place DALE046 and its siblings never looked. -->
        <ProjectReference Include="..\Vion.Dale.Sdk.Generators\Vion.Dale.Sdk.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer"/>
    </ItemGroup>

</Project>
